# ============================================================
# Cargo / Rust 构建产物与依赖
# ============================================================
# target/ 是 cargo build 生成的二进制/中间产物目录，永远不该入库。
target/
**/*.rs.bk
**/*.pdb

# Cargo 自己维护的 .cargo 缓存目录（本地配置 + 缓存索引）
.cargo/
.cargo-ok

# ============================================================
# 敏感信息（凭据 / 密钥 / 本地环境变量）
# ============================================================
# .env 及其衍生文件；B 站 Cookie 等敏感输入切勿提交。
.env
.env.*
!.env.example
*.key
*.pem
*.p12

# ============================================================
# IDE / 编辑器 配置与缓存
# ============================================================
# JetBrains IDE（IntelliJ IDEA / RustRover / CLion / GoLand 等）
.idea/
*.iml
*.iws
*.ipr
out/

# ZCode
.zcode/

# VS Code
.vscode/
.vscode-test/

# Cursor
.cursor/

# Fleet
.fleet/
.fleet.json

# Neovim / Vim / Emacs 临时文件
*.swp
*.swo
*~
*.bak
*.tmp
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================================
# 操作系统生成文件
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================================
# 运行时 / 调试产物
# ============================================================
# 日志
*.log
logs/

# live_check 真机联调输出（含私有服务器信息，不入库）
live_check*.out

# 性能分析 / 覆盖率
coverage/
*.lcov
*.profraw
*.profdata

# 临时构建文件
*.o.bk
*.d.bk

# ============================================================
# 项目本地副产物
# ============================================================
# 截图脚本生成的预览图（按需保留时再加 ! 排除规则）
ui_preview_*.png

# 下载目录（计划文本导出可能产生的临时副本）
downloads/

# Rust 工具链切换文件
rust-toolchain.toml.bak
# ============================================================
# 智能体 / AI 工具本地工作区
# ============================================================
# WorkBuddy 智能体项目工作区（记忆、日志等本地数据，不入库）
.workbuddy/

# ============================================================
# 其他临时残留
# ============================================================
# Git 合并冲突残留
*.orig
*.rej

# VS Code Local History 插件本地历史
.history/

# Node 工具链（若未来引入前端辅助脚本）
node_modules/
